{
  "name": "vs-clone-installer",
  "version": "1.0.0",
  "private": true,
  "description": "Visual Studio Clone Installer",
  "author": "Visual Studio Clone",
  "type": "commonjs",
  "main": "main.cjs",
  "build": {
    "appId": "com.vsclone.installer",
    "productName": "Visual Studio Clone Installer",
    "electronVersion": "45.1.0",
    "asar": true,
    "directories": {
      "output": "../Release/installer-ui",
      "buildResources": "."
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/**/*",
      "icon.ico"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "portable": {
      "artifactName": "VisualStudioClone-Installer-${version}.${ext}"
    }
  }
}
